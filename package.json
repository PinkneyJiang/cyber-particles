{
  "name": "@pinkney/cyber-particles",
  "version": "1.0.0",
  "description": "Ultra-smooth, 60 FPS cyberpunk particle fluid engine (Matrix Rain, Aurora, Sakura Drift, Gold Dust) for React & Vanilla Canvas.",
  "author": "Pinkney Jiang <pinkney.jiang@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pinkney/profile-pinkney.git",
    "directory": "packages/cyber-particles"
  },
  "keywords": [
    "react",
    "canvas",
    "particles",
    "matrix-rain",
    "aurora",
    "sakura",
    "cyberpunk",
    "fluid",
    "animation",
    "60fps"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  }
}
